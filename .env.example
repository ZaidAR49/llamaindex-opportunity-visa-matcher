# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended Cheapest Models:
# - "deepseek/deepseek-chat" (Ultra cheap ~$0.14/1M tokens, highly capable in Arabic & English)
# - "deepseek/deepseek-chat:free" (Free on OpenRouter)
# - "google/gemini-2.0-flash-001" (~$0.10/1M tokens)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Default Visa Rules URL (Official immigration page or Wikipedia guide)
VISA_RULES_URL=https://en.wikipedia.org/wiki/Visa_policy_of_the_Schengen_Area

# (Optional Fallback) Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
